# Copy to .env and fill in. Every value is optional: without them Geo-VLA runs
# in offline demo mode (rule-based planner + synthetic data + classical fallbacks).

# --- LLM reasoning layer (free-text questions; workflows don't need it) ---
# Any open model with function calling works. Easiest: a free Groq key from https://console.groq.com/keys
GROQ_API_KEY=
# Alternatives (first key found wins when LLM_PROVIDER=auto):
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
# Local, fully offline models with Ollama (e.g. `ollama pull qwen2.5:7b`):
OLLAMA_URL=
# Any other OpenAI-compatible server (vLLM, LM Studio, LiteLLM…):
LLM_BASE_URL=
LLM_API_KEY=
ANTHROPIC_API_KEY=
# auto | groq | openrouter | together | ollama | openai | anthropic | none
LLM_PROVIDER=auto
# Override the model, e.g. llama-3.3-70b-versatile, qwen/qwen3-32b, openai/gpt-oss-120b (Groq)
LLM_MODEL=
LLM_TEMPERATURE=0.1
GEO_VLA_MAX_TURNS=12

# --- Copernicus Data Space Ecosystem (free: https://dataspace.copernicus.eu → User settings → OAuth clients) ---
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# auto = live when Copernicus credentials are set, else synthetic. Or force: live | synthetic
GEO_VLA_DATA_MODE=auto

# --- Local paths ---
MODEL_CHECKPOINT_DIR=./models/checkpoints
DEM_TILE_CACHE_DIR=./data/dem_cache
IMAGERY_CACHE_DIR=./data/imagery_cache

# --- App ---
PORT=8000
LOG_LEVEL=INFO
# Comma-separated allowed origins; restrict before deploying publicly.
CORS_ORIGINS=*

# --- Accounts ---
# The first admin is created on startup from these (only if no admin exists yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Let anyone create a 'public' account (officials are created/upgraded by an admin).
ALLOW_PUBLIC_SIGNUP=1
SESSION_DAYS=14

# --- Storage ---
GEO_VLA_DATA_DIR=./data
MODEL_REGISTRY_DIR=./models/registry
# Analyses run without signing in are deleted after this many hours unless saved.
ANON_RUN_TTL_HOURS=24
MAX_CONCURRENT_RUNS=4

# --- Monitoring & alerts ---
# Seconds between checks for due monitors (0 disables the scheduler).
MONITOR_INTERVAL_SEC=300
# Optional email delivery of alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=geo-vla@example.org
# Optional webhook (e.g. Slack / Teams incoming webhook) for alerts
ALERT_WEBHOOK_URL=
