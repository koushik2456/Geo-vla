# Copy to .env and fill in. Every value is optional: without them Geo-VLA runs
# in offline demo mode (rule-based planner + synthetic data + classical fallbacks).

# --- LLM reasoning layer (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
GEO_VLA_MODEL=claude-sonnet-5
# "summarized" shows Claude's reasoning summaries in the trace panel; "off" hides them.
GEO_VLA_THINKING=summarized
GEO_VLA_MAX_TURNS=12

# --- Copernicus Data Space Ecosystem (free: https://dataspace.copernicus.eu → User settings → OAuth clients) ---
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# auto = live when Copernicus credentials are set, else synthetic. Or force: live | synthetic
GEO_VLA_DATA_MODE=auto

# --- Local paths ---
MODEL_CHECKPOINT_DIR=./models/checkpoints
DEM_TILE_CACHE_DIR=./data/dem_cache
IMAGERY_CACHE_DIR=./data/imagery_cache

# --- App ---
PORT=8000
LOG_LEVEL=INFO
# Comma-separated allowed origins; restrict before deploying publicly.
CORS_ORIGINS=*
