# Backend URL. Leave empty when the backend serves the frontend (same origin) or in `npm run dev` (proxied).
VITE_API_URL=
# Optional free Cesium ion token (https://ion.cesium.com) — enables Cesium World Terrain on the 3D globe.
VITE_CESIUM_ION_TOKEN=
# Optional build-time fallbacks (the backend .env values are preferred):
VITE_GOOGLE_MAPS_API_KEY=
